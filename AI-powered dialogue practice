<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI 외국어 대화 연습</title>
  <style>
    :root {
      --bg-color: #f8f9fa;
      --card-bg: #ffffff;
      --text-main: #2b2d42;
      --text-sub: #6c757d;
      --primary: #4a7c59;
      --primary-hover: #3b6346;
      --ai-bubble: #e9ecef;
      --user-bubble: #e8f5e9;
      --active-highlight: #fff3cd;
      --diff-added: #d1ecf1;
      --border-radius: 12px;
    }
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-main); margin: 0; padding: 20px; display: flex; justify-content: center; }
    .container { width: 100%; max-width: 800px; background: var(--card-bg); padding: 30px; border-radius: var(--border-radius); box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
    h1, h2 { color: var(--text-main); margin-top: 0; }
    .subtitle { color: var(--text-sub); font-size: 0.95rem; margin-bottom: 25px; }
    .step { display: none; }
    .step.active { display: block; }
    .form-group { margin-bottom: 18px; }
    label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
    input[type="text"], select, textarea { width: 100%; padding: 10px 14px; border: 1px solid #ced4da; border-radius: 8px; font-size: 0.95rem; outline: none; }
    input:focus, select:focus, textarea:focus { border-color: var(--primary); }
    .form-row { display: flex; gap: 15px; }
    .form-row .form-group { flex: 1; }
    
    .key-info { margin-top: 6px; font-size: 0.8rem; color: var(--text-sub); }
    .key-info a { color: var(--primary); font-weight: 600; text-decoration: none; }
    .key-info a:hover { text-decoration: underline; }

    button { background: var(--primary); color: white; border: none; padding: 12px 24px; font-size: 1rem; font-weight: 600; border-radius: 8px; cursor: pointer; transition: 0.2s; width: 100%; margin-top: 10px; }
    button:hover { background: var(--primary-hover); }
    button:disabled { background: #adb5bd; cursor: not-allowed; }
    .btn-secondary { background: #6c757d; }
    .btn-secondary:hover { background: #5a6268; }
    .btn-warning { background: #e67e22; }
    .btn-warning:hover { background: #d35400; }

    .chat-box { display: flex; flex-direction: column; gap: 15px; margin: 20px 0; max-height: 450px; overflow-y: auto; padding-right: 5px; }
    .turn-card { padding: 15px; border-radius: var(--border-radius); border: 2px solid transparent; transition: all 0.3s ease; cursor: pointer; position: relative; }
    .turn-card:hover { border-color: #ced4da; }
    .turn-card.ai { background-color: var(--ai-bubble); align-self: flex-start; width: 90%; }
    .turn-card.user { background-color: var(--user-bubble); align-self: flex-end; width: 90%; }
    .turn-card.active-turn { background-color: var(--active-highlight); border-color: #ffe082; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .speaker-label { font-size: 0.8rem; font-weight: bold; color: var(--text-sub); margin-bottom: 4px; display: flex; justify-content: space-between; }
    .script-text { font-size: 1.05rem; line-height: 1.5; }
    
    .control-panel { text-align: center; margin-top: 20px; padding-top: 15px; border-top: 1px solid #e9ecef; }
    .audio-controls { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 10px; }
    .audio-controls button { margin-top: 0; font-size: 0.85rem; padding: 10px 5px; }
    .status-msg { font-size: 0.9rem; color: var(--primary); font-weight: bold; margin-bottom: 10px; min-height: 1.2em; }
    .diff-container { display: flex; flex-direction: column; gap: 20px; margin: 20px 0; }
    .diff-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; background: #fdfdfd; padding: 15px; border-radius: 8px; border: 1px solid #e9ecef; }
    .diff-box h4 { margin: 0 0 8px 0; font-size: 0.85rem; color: var(--text-sub); }
    .diff-text { font-size: 0.95rem; line-height: 1.6; }
    .ins { background-color: var(--diff-added); padding: 2px 4px; border-radius: 4px; }
    .loading-spinner { text-align: center; padding: 40px; color: var(--text-sub); }
    
    .speed-control-bar { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-bottom: 15px; background: #f1f3f5; padding: 8px 15px; border-radius: 8px; }
    .speed-control-bar label { font-size: 0.85rem; font-weight: bold; margin: 0; color: var(--text-main); }
    .speed-control-bar select { width: auto; padding: 4px 8px; font-size: 0.85rem; }
  </style>
</head>
<body>

<div class="container">
  <!-- 1단계: 대본 생성 설정 -->
  <div id="step-1" class="step active">
    <h1>🌱 AI 대화 연습 설정</h1>
    <p class="subtitle">원하는 대화 상황과 난이도를 설정해 주세요.</p>
    
    <div class="form-row">
      <div class="form-group">
        <label>사용할 AI 모델</label>
        <select id="apiProvider">
          <option value="gemini">Google Gemini (gemini-2.5-flash)</option>
          <option value="openai">OpenAI (gpt-4o-mini)</option>
        </select>
      </div>
      <div class="form-group">
        <label>API 키 입력</label>
        <input type="text" id="apiKey" placeholder="API Key를 입력하세요">
        <div class="key-info">
          🔑 키가 없으신가요? 
          <a id="keyLink" href="https://aistudio.google.com/" target="_blank">Google API Key 발급받기 ↗</a>
        </div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>학습 언어</label>
        <select id="language">
          <option value="English">영어 (English)</option>
          <option value="Japanese">일본어 (Japanese)</option>
          <option value="Chinese">중국어 (Chinese)</option>
          <option value="Spanish">스페인어 (Spanish)</option>
        </select>
      </div>
      <div class="form-group">
        <label>문장 길이</label>
        <select id="length">
          <option value="short">짧은 문장</option>
          <option value="medium" selected>보통 문장</option>
          <option value="long">긴 문장</option>
        </select>
      </div>
      <div class="form-group">
        <label>대화 턴 수</label>
        <select id="turns">
          <option value="3" selected>3 턴</option>
          <option value="5">5 턴</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>주제 및 상황</label>
      <input type="text" id="context" placeholder="예: 카페에서 음료 주문하기">
    </div>

    <div class="form-group">
      <label>기타 추가 요청사항</label>
      <textarea id="customNotes" rows="2" placeholder="예: 비즈니스 어휘 위주로 구성해 줘"></textarea>
    </div>

    <button type="button" onclick="requestMicPermissionAndStart()">맞춤 대본 생성하기</button>
  </div>

  <!-- 2단계: 미리보기 -->
  <div id="step-2" class="step">
    <h2>📜 맞춤 대화 대본 미리보기</h2>
    <p class="subtitle">생성된 대본을 클릭하여 들어보거나, 미리 읽은 후 음성 대화를 시작해 보세요.</p>
    
    <div class="speed-control-bar">
      <label for="step2-speed">🔊 AI 음성 속도:</label>
      <select id="step2-speed" onchange="syncSpeedOptions(this.value)">
        <option value="1.0">1.0배속</option>
        <option value="0.9">0.9배속</option>
        <option value="0.8">0.8배속</option>
        <option value="0.7" selected>0.7배속</option>
        <option value="0.6">0.6배속</option>
        <option value="0.5">0.5배속</option>
      </select>
    </div>

    <div id="preview-box" class="chat-box"></div>
    <button type="button" onclick="startPractice()">음성 대화 시작하기</button>
  </div>

  <!-- 3단계: 음성 대화 -->
  <div id="step-3" class="step">
    <h2>🎙️ 대화 진행 중</h2>
    <p class="subtitle">카드 문장을 클릭하면 언제든 다시 들을 수 있습니다.</p>
    
    <div class="speed-control-bar">
      <label for="step3-speed">🔊 AI 음성 속도:</label>
      <select id="step3-speed" onchange="syncSpeedOptions(this.value)">
        <option value="1.0">1.0배속</option>
        <option value="0.9">0.9배속</option>
        <option value="0.8">0.8배속</option>
        <option value="0.7" selected>0.7배속</option>
        <option value="0.6">0.6배속</option>
        <option value="0.5">0.5배속</option>
      </select>
    </div>

    <div id="practice-box" class="chat-box"></div>
    
    <div class="control-panel">
      <div class="audio-controls">
        <button type="button" class="btn-secondary" onclick="stopTTSOnly()">⏹️ 음성 멈추기</button>
        <button type="button" class="btn-secondary" onclick="replayCurrentTurn()">🔄 현재 문장 듣기</button>
        <button type="button" class="btn-warning" onclick="resetPractice()">⏪ 대화 초기화</button>
      </div>
      <div id="status-msg" class="status-msg">준비 중...</div>
      <button type="button" id="mic-btn" onclick="toggleRecord()" disabled>🎤 말하기 시작</button>
    </div>
  </div>

  <!-- 4단계: 피드백 -->
  <div id="step-4" class="step">
    <h2>📊 대화 대조 피드백</h2>
    <p class="subtitle">견본 대본과 실제 사용자의 발화를 비교한 결과입니다.</p>
    <div id="diff-box" class="diff-container"></div>
    <button type="button" onclick="location.reload()">처음으로 돌아가기</button>
  </div>
</div>

<script>
  var scriptData = [];
  var currentTurn = 0;
  var userRecordings = [];
  var recognition = null;
  var isRecording = false;

  document.getElementById('apiProvider').addEventListener('change', function(e) {
    var link = document.getElementById('keyLink');
    if (e.target.value === 'gemini') {
      link.href = 'https://aistudio.google.com/';
      link.innerText = 'Google API Key 발급받기 ↗';
    } else {
      link.href = 'https://platform.openai.com/api-keys';
      link.innerText = 'OpenAI API Key 발급받기 ↗';
    }
  });

  function syncSpeedOptions(val) {
    document.getElementById('step2-speed').value = val;
    document.getElementById('step3-speed').value = val;
  }

  // 브라우저 마이크 권한 요청 팝업을 직접 호출하는 함수
  async function requestMicPermissionAndStart() {
    var apiKeyVal = document.getElementById('apiKey').value.trim();
    if (!apiKeyVal) {
      alert("API 키를 입력해 주세요.");
      return;
    }

    try {
      // 핵심: 브라우저에 마이크 허용 팝업 요청
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      stream.getTracks().forEach(track => track.stop()); // 권한 확인 후 스트림 닫기
      generateScript();
    } catch (err) {
      alert("마이크 사용 권한을 '허용'하셔야 음성 대화를 진행하실 수 있습니다.");
    }
  }

  async function generateScript() {
    var config = {
      provider: document.getElementById('apiProvider').value,
      apiKey: document.getElementById('apiKey').value.trim(),
      language: document.getElementById('language').value,
      length: document.getElementById('length').value,
      turns: document.getElementById('turns').value,
      context: document.getElementById('context').value,
      customNotes: document.getElementById('customNotes').value
    };

    showStep('step-2');
    document.getElementById('preview-box').innerHTML = '<div class="loading-spinner">✨ 맞춤 대본을 생성하고 있습니다...</div>';

    const prompt = `Create a realistic dialogue script based on the following requirements:
- Language: ${config.language}
- Context/Topic: ${config.context}
- Sentence Complexity: ${config.length}
- Number of Turns: ${config.turns} turns (1 turn = 1 AI response + 1 User response)
- Additional Notes: ${config.customNotes}

CRITICAL: Return ONLY a valid JSON Array format like below, with no extra text or markdown syntax.
[
  {"role": "AI", "text": "..."},
  {"role": "User", "text": "..."}
]`;

    try {
      let jsonString = "";
      if (config.provider === 'gemini') {
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${config.apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error.message);
        jsonString = data.candidates[0].content.parts[0].text;
      } else {
        const res = await fetch(`https://api.openai.com/v1/chat/completions`, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${config.apiKey}`
          },
          body: JSON.stringify({
            model: "gpt-4o-mini",
            messages: [{ role: "system", content: "You output JSON arrays only." }, { role: "user", content: prompt }]
          })
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error.message);
        jsonString = data.choices[0].message.content;
      }

      jsonString = jsonString.replace(/```json/g, "").replace(/```/g, "").trim();
      onScriptGenerated(jsonString);
    } catch (err) {
      alert("API 오류: " + err.message);
      showStep('step-1');
    }
  }

  function onScriptGenerated(jsonString) {
    try {
      scriptData = JSON.parse(jsonString);
      var previewBox = document.getElementById('preview-box');
      previewBox.innerHTML = '';

      scriptData.forEach(function(item) {
        var div = document.createElement('div');
        div.className = 'turn-card ' + (item.role === 'AI' ? 'ai' : 'user');
        div.innerHTML = '<div class="speaker-label"><span>' + item.role + '</span><span>🔊 클릭해서 듣기</span></div><div class="script-text">' + item.text + '</div>';
        div.onclick = function() { speakSingleSentence(item.text); };
        previewBox.appendChild(div);
      });
    } catch (e) {
      alert("대본 해석 중 오류가 발생했습니다.");
      showStep('step-1');
    }
  }

  function startPractice() {
    stopTTSOnly();
    showStep('step-3');
    var practiceBox = document.getElementById('practice-box');
    practiceBox.innerHTML = '';

    scriptData.forEach(function(item, index) {
      var div = document.createElement('div');
      div.id = 'practice-turn-' + index;
      div.className = 'turn-card ' + (item.role === 'AI' ? 'ai' : 'user');
      div.innerHTML = '<div class="speaker-label"><span>' + item.role + '</span><span>🔊 클릭해서 듣기</span></div><div class="script-text">' + item.text + '</div>';
      div.onclick = function() { speakSingleSentence(item.text); };
      practiceBox.appendChild(div);
    });

    currentTurn = 0;
    userRecordings = [];
    processTurn();
  }

  function resetPractice() {
    stopTTSOnly();
    if (isRecording && recognition) {
      try { recognition.stop(); } catch(e){}
      isRecording = false;
    }
    currentTurn = 0;
    userRecordings = [];
    processTurn();
  }

  function processTurn() {
    if (currentTurn >= scriptData.length) {
      finishPractice();
      return;
    }

    scriptData.forEach(function(_, idx) {
      var el = document.getElementById('practice-turn-' + idx);
      if (idx === currentTurn) {
        el.classList.add('active-turn');
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        el.classList.remove('active-turn');
      }
    });

    var turnData = scriptData[currentTurn];
    var statusMsg = document.getElementById('status-msg');
    var micBtn = document.getElementById('mic-btn');

    if (turnData.role === 'AI') {
      statusMsg.innerText = "🤖 AI가 말하는 중입니다...";
      micBtn.disabled = true;
      micBtn.innerText = "🎤 말하기 대기 중";
      speakTTS(turnData.text, function() {
        currentTurn++;
        processTurn();
      });
    } else {
      statusMsg.innerText = "🎤 당신의 차례입니다. 마이크 버튼을 누르고 말씀하세요.";
      micBtn.disabled = false;
      micBtn.innerText = "🎤 말하기 시작";
    }
  }

  function speakTTS(text, onEndCallback) {
    window.speechSynthesis.cancel();
    var utterance = new SpeechSynthesisUtterance(text);
    applyTTSConfig(utterance);
    utterance.onend = function() { if (onEndCallback) onEndCallback(); };
    window.speechSynthesis.speak(utterance);
  }

  function speakSingleSentence(text) {
    window.speechSynthesis.cancel();
    var utterance = new SpeechSynthesisUtterance(text);
    applyTTSConfig(utterance);
    window.speechSynthesis.speak(utterance);
  }

  function applyTTSConfig(utterance) {
    var langSelect = document.getElementById('language').value;
    var speedVal = parseFloat(document.getElementById('step3-speed').value);
    utterance.rate = speedVal * 0.85;

    if (langSelect === 'English') utterance.lang = 'en-US';
    else if (langSelect === 'Japanese') utterance.lang = 'ja-JP';
    else if (langSelect === 'Chinese') utterance.lang = 'zh-CN';
    else if (langSelect === 'Spanish') utterance.lang = 'es-ES';
  }

  function stopTTSOnly() {
    window.speechSynthesis.cancel();
  }

  function replayCurrentTurn() {
    if (scriptData[currentTurn]) {
      speakSingleSentence(scriptData[currentTurn].text);
    }
  }

  function initSTT() {
    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
      alert("이 브라우저는 음성 인식을 지원하지 않습니다. Chrome 브라우저를 이용해 주세요.");
      return false;
    }

    recognition = new SpeechRecognition();
    var langSelect = document.getElementById('language').value;
    if (langSelect === 'English') recognition.lang = 'en-US';
    else if (langSelect === 'Japanese') recognition.lang = 'ja-JP';
    else if (langSelect === 'Chinese') recognition.lang = 'zh-CN';
    else if (langSelect === 'Spanish') recognition.lang = 'es-ES';

    recognition.interimResults = false;
    recognition.continuous = false;

    recognition.onstart = function() {
      isRecording = true;
      document.getElementById('mic-btn').innerText = "⏹️ 녹음 중지 및 제출";
      document.getElementById('status-msg').innerText = "🎙️ 듣고 있습니다... 말씀하세요!";
    };

    recognition.onresult = function(event) {
      var transcript = event.results[0][0].transcript;
      userRecordings.push({
        turnIndex: currentTurn,
        expected: scriptData[currentTurn].text,
        actual: transcript
      });
      
      stopRecordingUI();
      currentTurn++;
      processTurn();
    };

    recognition.onerror = function(e) {
      stopRecordingUI();
      if (e.error === 'no-speech') {
        document.getElementById('status-msg').innerText = "⚠️ 음성이 감지되지 않았습니다. 다시 버튼을 눌러주세요.";
      } else {
        document.getElementById('status-msg').innerText = "⚠️ 음성 인식 오류가 발생했습니다. 다시 눌러주세요.";
      }
    };

    recognition.onend = function() {
      stopRecordingUI();
    };

    return true;
  }

  function toggleRecord() {
    stopTTSOnly();
    if (!recognition) {
      var ok = initSTT();
      if (!ok) return;
    }

    if (!isRecording) {
      try {
        recognition.start();
      } catch (err) {
        initSTT();
        setTimeout(function() { recognition.start(); }, 200);
      }
    } else {
      try { recognition.stop(); } catch(e){}
      stopRecordingUI();
    }
  }

  function stopRecordingUI() {
    isRecording = false;
    var micBtn = document.getElementById('mic-btn');
    if (scriptData[currentTurn] && scriptData[currentTurn].role === 'User') {
      micBtn.innerText = "🎤 말하기 시작";
      micBtn.disabled = false;
    }
  }

  function finishPractice() {
    showStep('step-4');
    var diffBox = document.getElementById('diff-box');
    diffBox.innerHTML = '';

    userRecordings.forEach(function(rec) {
      var row = document.createElement('div');
      row.className = 'diff-row';
      var diffHTML = computeDiffHTML(rec.expected, rec.actual);

      row.innerHTML = '<div class="diff-box"><h4>📌 견본 대본</h4><div class="diff-text">' + rec.expected + '</div></div><div class="diff-box"><h4>🗣️ 학생 실제 발화 (대조)</h4><div class="diff-text">' + diffHTML + '</div></div>';
      diffBox.appendChild(row);
    });
  }

  function computeDiffHTML(expected, actual) {
    var expWords = expected.split(" ");
    var actWords = actual.split(" ");
    var resultHTML = "";

    actWords.forEach(function(word) {
      var cleanWord = word.replace(/[.,?!]/g, "").toLowerCase();
      var isMatch = expWords.some(function(w) { return w.replace(/[.,?!]/g, "").toLowerCase() === cleanWord; });

      if (isMatch) {
        resultHTML += word + ' ';
      } else {
        resultHTML += '<span class="ins">' + word + '</span> ';
      }
    });

    return resultHTML;
  }

  function showStep(stepId) {
    document.querySelectorAll('.step').forEach(function(el) { el.classList.remove('active'); });
    document.getElementById(stepId).classList.add('active');
  }
</script>
</body>
</html>
